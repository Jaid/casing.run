{
  "name": "casing.run",
  "displayName": "Casing.run",
  "version": "0.1.0",
  "type": "module",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/casing.run.git"
  },
  "exports": {
    ".": {
      "default": "./src/main.ts"
    }
  },
  "imports": {
    "#component/*": "./src/components/*/index.tsx",
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "build": "bun run vite build --mode development",
    "build:production": "bun run vite build --mode production",
    "lint": "tsc --noEmit --noUnusedLocals --pretty false && knip-bun --exclude dependencies --reporter json",
    "serve": "bun run build:production && bun run vite --port 443 --host 0.0.0.0 preview --outDir dist/production",
    "test": "bun test --max-concurrency 1 ./test",
    "test-live": "bun run build:production && target=dist/production bun test test/live.test.ts",
    "vite": "bun node_modules/vite/dist/node/cli.js --configLoader runner"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "mount-root": "0.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite-plugin-media-mixins": "0.10.0",
    "vite-plugin-title": "0.6.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.5",
    "@rolldown/plugin-babel": "0.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.6.1",
    "babel-plugin-react-compiler": "1.0.0",
    "browserslist": "4.29.0",
    "caniuse-lite": "1.0.30001810",
    "count-in-png": "0.1.0",
    "cssnano-preset-advanced": "9.0.5",
    "es-toolkit": "1.52.0",
    "eslint": "10.10.0",
    "eslint-config-jaid": "33.0.0",
    "fs-extra": "11.4.0",
    "knip": "6.37.0",
    "optis": "0.1.0",
    "postcss-normalize": "13.0.1",
    "postcss-sass": "0.5.0",
    "puppeteer-core": "25.11.0",
    "sass-embedded": "1.104.1",
    "stylelint": "17.15.0",
    "tsconfig-jaid-react": "16.0.0",
    "type-fest": "5.10.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "@types/bun": "1.4.2",
    "@types/postcss-normalize": "9.0.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
